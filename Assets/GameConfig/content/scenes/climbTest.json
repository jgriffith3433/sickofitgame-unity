  "rules": [
    {
      "name": "the first stone sinks under him",
      "when": {
        "type": "playerOn",
        "target": {
          "id": "stone1"
        }
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "showText",
          "text": "It sinks if I stop. So I don't stop.",
          "duration": 2.5,
          "style": "Subtitle",
          "sound": "vo_crust_sink"
        }
      ]
    },
    {
      "name": "the raft",
      "when": {
        "type": "playerOn",
        "target": {
          "id": "raft1"
        }
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "showText",
          "text": "Free ride. Over lava. Lovely.",
          "duration": 2.5,
          "style": "Subtitle"
        }
      ]
    },
    {
      "name": "the river is a breather: the lava stops",
      "when": {
        "type": "sectionReached",
        "section": "river"
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "setCounter",
          "name": "lavaSpeed",
          "value": 0.0
        }
      ]
    },
    {
      "name": "the chase",
      "when": {
        "type": "sectionReached",
        "section": "chase"
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "playSound",
          "sound": "magma_rumble"
        },
        {
          "type": "cameraShake",
          "intensity": 0.08,
          "duration": 1.2
        },
        {
          "type": "showText",
          "text": "RUN, LITTLE MAN! RUN!",
          "duration": 2.0,
          "style": "Banner",
          "color": "#FFD27A"
        }
      ]
    },
    {
      "name": "up again: the lava follows",
      "when": {
        "type": "sectionReached",
        "section": "upagain"
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "setCounter",
          "name": "lavaMax",
          "value": 18.0
        },
        {
          "type": "setCounter",
          "name": "lavaSpeed",
          "value": 0.35
        },
        {
          "type": "showText",
          "text": "It's following me. Of course.",
          "duration": 2.5,
          "style": "Subtitle"
        }
      ]
    },
    {
      "name": "the landing",
      "when": {
        "type": "playerOn",
        "target": {
          "id": "landing"
        }
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "emit",
          "signal": "landed"
        },
        {
          "type": "runSequence",
          "steps": [
            {
              "type": "showText",
              "text": "THE LANDING... SURVIVED!",
              "duration": 2.5,
              "style": "Banner",
              "sound": "vo_landing_clear",
              "color": "#FFD27A"
            },
            {
              "type": "wait",
              "seconds": 3.0
            },
            {
              "type": "completeLevel"
            }
          ]
        }
      ]
    }
  ],
  "phases": [
    {
      "name": "climb",
      "onEnter": [
        {
          "type": "runSequence",
          "steps": [
            {
