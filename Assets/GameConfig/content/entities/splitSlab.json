{
  "schemaVersion": 1,
  "extends": "crumblingStone",
  "tags": [
    "foothold",
    "road"
  ],
  "visual": {
    "color": "#FFFFFF",
    "placeholderColor": "#3A2A2E",
    "animator": {
      "parameters": [
        {
          "name": "Cracked",
          "type": "Bool",
          "defaultValue": 0
        },
        {
          "name": "Falling",
          "type": "Bool",
          "defaultValue": 0
        }
      ],
      "states": [
        {
          "stateName": "Idle",
          "spriteSheet": "Art/Climb/SplitSlab_idle.png",
          "fps": 12,
          "loop": true,
          "events": []
        },
        {
          "stateName": "Crack",
          "spriteSheet": "Art/Climb/SplitSlab_crack.png",
          "fps": 8,
          "loop": false,
          "events": []
        },
        {
          "stateName": "Fall",
          "spriteSheet": "Art/Climb/SplitSlab_fall.png",
          "fps": 12,
          "loop": false,
          "events": []
        }
      ],
      "transitions": [
        {
          "fromState": "Idle",
          "toState": "Crack",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "Cracked",
              "mode": "If",
              "threshold": 0
            }
          ]
        },
        {
          "fromState": "Crack",
          "toState": "Fall",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "Falling",
              "mode": "If",
              "threshold": 0
            }
          ]
        },
        {
          "fromState": "Crack",
          "toState": "Idle",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "Cracked",
              "mode": "IfNot",
              "threshold": 0
            }
          ]
        },
        {
          "fromState": "Fall",
          "toState": "Idle",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "Cracked",
              "mode": "IfNot",
              "threshold": 0
            }
          ]
        }
      ],
      "defaultStateName": "Idle"
    }
  },
  "abilities": [
    {
      "type": "crumble",
      "delay": 0.8,
      "shake": 0.05,
      "gravity": 16.0,
      "fallDistance": 14.0,
      "crackSound": "slag_drip",
      "fallSound": "lava_burst"
    }
