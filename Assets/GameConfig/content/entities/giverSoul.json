{
  "schemaVersion": 1,
  "extends": "damnedSoul",
  "tags": ["damned", "bystander"],
  "abilities": [
    {
      "type": "react",
      "when": {
        "type": "distanceToPlayer",
        "below": 3.2
      },
      "maxTimes": 1,
      "do": [
        {
          "type": "faceEntity",
          "target": "self",
          "toward": "player"
        },
        {
          "type": "showText",
          "text": "Here. It's not mine. ...It's not mine.",
          "duration": 2.6,
          "style": "Subtitle",
          "color": "#D2DAE4",
          "sound": "vo_by_giver_hand"
        },
        {
          "type": "playEntityAnimation",
          "target": "self",
          "state": "Hiccup"
        },
        {
          "type": "spawn",
          "entity": "rewindOrb",
          "anchor": "Self",
          "at": [-0.7, 0.4],
          "facePlayer": false
        },
        {
          "type": "emit",
          "signal": "by:giver:hand"
        }
      ]
    }
  ],
  "visual": {
    "animator": {
      "parameters": [
        {
          "name": "Hiccup",
          "type": "Trigger",
          "defaultValue": 0
        }
      ],
      "states": [
        {
          "stateName": "Idle",
          "spriteSheet": "Art/Enemies/GiverSoul/GiverSoul_idle.png",
          "fps": 12,
          "loop": true,
          "events": []
        },
        {
          "stateName": "Hiccup",
          "spriteSheet": "Art/Enemies/GiverSoul/GiverSoul_hiccup.png",
          "fps": 12,
          "loop": false,
          "events": []
        }
      ],
      "transitions": [
        {
          "fromState": "Idle",
          "toState": "Hiccup",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "Hiccup",
              "mode": "If",
              "threshold": 0
            }
          ]
        },
        {
          "fromState": "Hiccup",
          "toState": "Idle",
          "hasExitTime": true,
          "exitTime": 1,
          "conditions": []
        }
      ],
      "defaultStateName": "Idle"
    },
    "facesLeft": false
  }
}
