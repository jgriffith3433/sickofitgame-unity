  "hintVoice": "vo_hero_hint_brimstoneDemon",
  "onSpawn": [{ "type": "hintOnce" }],
  "extends": "shooter",
  "health": 4,
  "moveSpeed": 0.7,
  "tags": ["brimstoneDemon"],
  "body": {
    "radius": 0.45,
    "solid": false
  },
  "visual": {
    "fxColor": "#FF6A1F",
