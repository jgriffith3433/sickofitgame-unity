      "flashColor": "#C58BFF",
      "sound": "banner_whoosh",
      "behind": true
    },
    {
      "type": "shoot",
      "projectile": "projectileEnemy",
      "speed": 3.8,
      "aim": "Player",
      "muzzle": [0.09, 0.09375],
      "interval": 2.4,
      "initialDelay": 1.8,
      "damage": 1,
      "animTrigger": "IsAttacking",
      "fireOnEvent": "FireProjectile",
      "burst": 2,
      "burstInterval": 0.3
    }
  ],
  "sounds": {
    "hurtSound": "blinkImp_hurt",
    "deathSound": "blinkImp_die",
    "attackSound": "blinkImp_attack"
  }
