{
  "schemaVersion": 1,
  "displayName": "Phase Raider",
  "hint": "Blinks in behind you and fires twice. Leave when the mark shows.",
  "note": "Never where I looked last.",
  "hintVoice": "vo_hero_hint_phaseRaider",
  "onSpawn": [
    {
      "type": "hintOnce"
    }
  ],
  "extends": "blinkImp",
  "health": 5,
  "tags": ["blinkImp", "elite", "imp", "phaseRaider"],
  "visual": {
    "scale": 0.36,
    "fxColor": "#C58BFF",
    "animator": {
      "parameters": [
        {
          "name": "IsAttacking",
          "type": "Trigger",
          "defaultValue": 0
        },
        {
          "name": "Hurt",
          "type": "Trigger",
          "defaultValue": 0
        }
      ],
      "states": [
        {
          "stateName": "Idle",
          "spriteSheet": "Art/Enemies/PhaseRaider/PhaseRaider_idle.png",
          "fps": 12,
          "loop": true,
          "events": []
        },
        {
          "stateName": "Attack",
          "spriteSheet": "Art/Enemies/PhaseRaider/PhaseRaider_attack.png",
          "fps": 12,
          "loop": false,
          "events": [
            {
              "frame": 13,
              "functionName": "FireProjectile"
            }
          ]
        },
        {
          "stateName": "Hurt",
          "spriteSheet": "Art/Enemies/PhaseRaider/PhaseRaider_hurt.png",
          "fps": 12,
          "loop": false,
          "events": []
        },
        {
          "stateName": "Die",
          "spriteSheet": "Art/Enemies/PhaseRaider/PhaseRaider_die.png",
          "fps": 12,
          "loop": false,
          "events": []
        }
      ],
      "transitions": [
        {
          "fromState": "Idle",
          "toState": "Attack",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "IsAttacking",
              "mode": "If",
              "threshold": 0
            }
          ]
        },
        {
          "fromState": "Attack",
          "toState": "Idle",
          "hasExitTime": true,
          "exitTime": 1,
          "conditions": []
        },
        {
          "fromState": "Idle",
          "toState": "Hurt",
          "hasExitTime": false,
          "exitTime": 1,
          "conditions": [
            {
              "parameterName": "Hurt",
              "mode": "If",
              "threshold": 0
            }
          ]
        },
        {
          "fromState": "Hurt",
          "toState": "Idle",
          "hasExitTime": true,
          "exitTime": 1,
          "conditions": []
        }
      ],
      "defaultStateName": "Idle"
    },
    "facesLeft": false
  },
  "healthBar": {
    "show": true,
    "color": [1, 0.82, 0.3, 1],
    "width": 0.6
