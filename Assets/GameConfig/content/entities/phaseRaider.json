  "loot": {
    "chance": 1,
    "count": 2,
    "value": 1
  },
  "drops": [
    {
      "entity": "rewindOrb",
      "chance": 0.5
    }
  ],
  "abilities": [
    {
      "type": "contactDamage",
      "damage": 1
