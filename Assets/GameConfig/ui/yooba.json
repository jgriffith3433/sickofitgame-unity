  "lines": [
    {
      "moment": "Hello",
      "floor": 0,
      "sound": "vo_yooba_hello",
      "text": "Ooh! You! From the village! It's me, Yooba! I came down the hole right after you. Bumpy slide, wasn't it?",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "Hello",
      "floor": 0,
      "sound": "vo_yooba_hello_count",
      "text": "And that big loud voice? \"Nine hundred ninety-nine to go!\" He says that to everyone. I counted.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "Hello",
      "floor": 0,
      "sound": "vo_yooba_hello_diamond",
      "text": "Oh! Nearly forgot. I swallowed the diamonds before the imps got 'em. Hrrk... there! Bring me more and I'll make you things.",
      "clip": "cough",
      "reply": "vo_hero_yooba_thanks",
      "replyText": "...Thanks. I think.",
      "once": true
    },
    {
      "moment": "Floor",
      "floor": 901,
      "sound": "vo_yooba_901",
      "text": "You melted the Magma King! He's a puddle! Oh, I'm telling everyone. Everyone!",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "Floor",
      "floor": 998,
      "sound": "vo_yooba_999",
      "text": "Nine hundred ninety-nine! The big voice loves that one. I've heard it four times now.",
      "clip": "laugh",
      "reply": "vo_hero_yooba_five",
      "replyText": "Five.",
      "once": true
    },
    {
      "moment": "Floor",
      "floor": 997,
      "sound": "vo_yooba_cart",
      "text": "Was that the baker's cart back there? Oh, he'll be furious. He's always furious. Lovely man.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "Floor",
      "floor": 953,
      "sound": "vo_yooba_loop",
      "text": "Did you notice 953 came round twice? I did. I notice everything. It's a gift.",
      "clip": "talk",
      "reply": "vo_hero_yooba_noticed",
      "replyText": "I noticed.",
      "once": true
    },
    {
      "moment": "Floor",
      "floor": 950,
      "sound": "vo_yooba_950",
      "text": "Halfway! Well. Halfway to nine hundred. Which is not very far, really. But what a lovely round number!",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "NearWarden",
      "floor": 10,
      "sound": "vo_yooba_door",
      "text": "Psst. That's his door. He can hear us. Hello, Your Majesty! ...He's horrible.",
      "clip": "talk",
      "reply": "vo_hero_yooba_quiet",
      "replyText": "Stop waving.",
      "once": true
    },
    {
      "moment": "NearWarden",
      "floor": 25,
      "sound": "vo_yooba_stairs",
      "text": "Those are the Magma King's stairs up there. He never gets up, you know. Not even for visitors. Rude, if you ask me.",
      "clip": "talk",
      "reply": "vo_hero_yooba_short",
      "replyText": "Good. I'll keep it short.",
      "once": true
    },
    {
      "moment": "Death",
      "floor": 0,
      "sound": "vo_yooba_splat",
      "text": "You went splat back there! Don't worry, I didn't tell anyone. ...I told everyone.",
      "clip": "laugh",
      "reply": "vo_hero_yooba_course",
      "replyText": "Of course you did.",
      "once": false
    },
    {
      "moment": "Death",
      "floor": 0,
      "sound": "vo_yooba_again",
      "text": "Back again? Hell does that. You go splat, it puts you back. Like me, after lunch.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "Grudge",
      "floor": 0,
      "sound": "vo_yooba_grudge",
      "text": "Ooh, a new grudge! I can smell it on you. Smells like spite. Suits you.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "Grudge",
      "floor": 0,
      "sound": "vo_yooba_grudges",
      "text": "Another grudge? You collect those like I collect diamonds. In my tummy.",
      "clip": "talk",
      "reply": "vo_hero_yooba_hobby",
      "replyText": "Everybody needs a hobby.",
      "once": true
    },
    {
      "moment": "Chatter",
      "floor": 0,
      "sound": "vo_yooba_rock",
      "text": "Did you know every floor down here has the same rock? I licked three. Same taste.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "Chatter",
      "floor": 0,
      "sound": "vo_yooba_sacks",
      "text": "The imps keep dropping their sacks. Finders keepers, I say! Mostly keepers.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "Chatter",
      "floor": 0,
      "sound": "vo_yooba_gossip",
      "text": "The baker's daughter fancies the blacksmith, by the way. Thought you should know. Before we're all toast.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopWelcome",
      "floor": 0,
      "sound": "vo_yooba_shop_hello",
      "text": "Welcome to Yooba's! Everything's made fresh. From my tummy.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopWelcome",
      "floor": 0,
      "sound": "vo_yooba_shop_hello2",
      "text": "Oh, it's you! My favourite! My only, but still. My favourite.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_shop_buy",
      "text": "Hrrk... there you go! Still warm.",
      "clip": "cough",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_shop_buy2",
      "text": "Ooh, good choice! I'd have picked that. I did pick that. I made it.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBroke",
      "floor": 0,
      "sound": "vo_yooba_shop_broke",
      "text": "Ooh, not enough shiny. Go bonk some imps, they're full of 'em.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBroke",
      "floor": 0,
      "sound": "vo_yooba_shop_broke2",
      "text": "Diamonds first, dear. I don't do tabs. I don't have pockets.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopLeave",
      "floor": 0,
      "sound": "vo_yooba_shop_bye",
      "text": "Bye bye! Don't die! Well, do. But come back.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopRecommend",
      "floor": 0,
      "sound": "vo_yooba_shop_pick",
      "text": "Psst! The glowing one. You can afford it. Start there.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true
    },
    {
      "moment": "ShopBuyWeapon",
      "floor": 0,
      "sound": "vo_yooba_weapon_thief",
      "text": "Hrrk... what's this? Fists? I don't make fists. I don't HAVE fists. You've been in my tummy, haven't you? THIEF!",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBuyWeapon",
      "floor": 0,
      "sound": "vo_yooba_weapon_mine",
      "text": "Weapons? What weapons? I have goo, and diamonds, and... That's MINE, isn't it? Somebody stole that from me! ...You stole that from me!",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBuyWeapon",
      "floor": 0,
      "sound": "vo_yooba_weapon_pockets",
      "text": "I don't have pockets, I don't have fists, and I definitely don't have weapons! So how did you take them from me?! Thief! Lovely, but thief!",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_plaster",
      "text": "A Goo Plaster! Hold still. Hrrk... there. Now you're a little bit me.",
      "clip": "cough",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "moreHealth",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_soles",
      "text": "Bouncy Soles! Don't ask where the bounce comes from. Nobody asks. It's so restful.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "extraJump",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_heels",
      "text": "Slick Heels! Fast as a rumour, and I'd know. I started most of them.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "comfySneakers",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_lining",
      "text": "Slimed Lining! Shove off and whoosh! Mind the coat. It's still a bit me.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "slimedLining",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_trigger",
      "text": "I licked that trigger myself. Twice, for luck. Don't wipe it.",
      "clip": "laugh",
      "reply": "vo_hero_yooba_wipe",
      "replyText": "Wouldn't dream of it.",
      "once": false,
      "item": "triggerFinger",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_dip",
      "text": "Tummy-dipped! Every shot goes through my stomach first. It's practically family.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "spicyFireballs",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_jar",
      "text": "A Loop Jar! Don't open it. It just keeps saying the same thing. Like everybody down here.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "juiceBox",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_sniffer",
      "text": "A Shiny Sniffer! It'll sniff your diamonds out. Mine too, so keep an eye on it.",
      "clip": "cough",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "diamondMagnet",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopBuy",
      "floor": 0,
      "sound": "vo_yooba_buy_doubledip",
      "text": "Double-dipped! That's the second dip. The third dip is a lifestyle.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "doubleDip",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopDeaths",
      "floor": 0,
      "sound": "vo_yooba_deaths_1",
      "text": "One splat! They grow up so fast. I've put a little tick on the wall. The wall is me.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 1,
      "requires": []
    },
    {
      "moment": "ShopDeaths",
      "floor": 0,
      "sound": "vo_yooba_deaths_5",
      "text": "Five splats! I've run out of wall. I'm ticking on my other side now.",
      "clip": "laugh",
      "reply": "vo_hero_yooba_deaths5",
      "replyText": "Stop counting.",
      "once": true,
      "item": "",
      "minDeaths": 5,
      "requires": []
    },
    {
      "moment": "ShopDeaths",
      "floor": 0,
      "sound": "vo_yooba_deaths_15",
      "text": "Fifteen! Hell's got a favourite, and I think it's you. It keeps picking you up and putting you down. Very fond.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 15,
      "requires": []
    },
    {
      "moment": "ShopDeaths",
      "floor": 0,
      "sound": "vo_yooba_deaths_40",
      "text": "Forty splats! I gave each one a name. They're all called 'Again'. ...Again. Again. Hello, Again.",
      "clip": "laugh",
      "reply": "vo_hero_yooba_deaths40",
      "replyText": "I hate that I laughed.",
      "once": true,
      "item": "",
      "minDeaths": 40,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_rock",
      "text": "New on the shelf! A rock I licked on nine-ninety-nine. Tastes like floor. Not for sale. For looking at.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "rockSample",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_wheel",
      "text": "That wheel's off the baker's cart! He'll want it back. I'll say it's a display. ...Don't tell him.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "cartWheel",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_pebble",
      "text": "A pebble from Floor 995! I put it on the shelf. It was there yesterday. And yesterday. And yesterday.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "loopPebble",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_sack",
      "text": "A scrap of the Foreman's sack! He's still looking for it. I'm not hiding it. It's decorating.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "sackScrap",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_pile",
      "text": "A crumb off the Pile Keeper's pile! Smells like a hundred hauls. Lovely.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "pileCrumb",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_soot",
      "text": "Soot from the King's chimney! Don't sneeze near it. I sneezed near it. Look at my shelf.",
      "clip": "cough",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "chimneySoot",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_king",
      "text": "A jar of Magma King! Well, of what's left. He's a bit runny but he's still smug. I can tell.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "kingPuddle",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_spire",
      "text": "A splinter off the Spire Fiend's road! Don't call it stealing. He grows more.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "spireSplinter",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopStocked",
      "floor": 0,
      "sound": "vo_yooba_stock_thanks",
      "text": "That jar's a thank-you. For you. It's empty. It's the thought, and the jar.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "thankYouJar",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopWelcome",
      "floor": 0,
      "sound": "vo_yooba_welcome_sack",
      "text": "Foreman's sack's gone quiet, hasn't it? I could hear it sulking from here. Welcome back!",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:11"
      ]
    },
    {
      "moment": "ShopWelcome",
      "floor": 0,
      "sound": "vo_yooba_welcome_chimney",
      "text": "You smell of chimney! Don't worry, I like it. I like everything. Come in, come in.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:22"
      ]
    },
    {
      "moment": "ShopWelcome",
      "floor": 0,
      "sound": "vo_yooba_welcome_king",
      "text": "The one who melted a king! In my shop! Mind the shelf, everything on it is very, very proud.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:31"
      ]
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_lick_1",
      "text": "Lick count: three rocks. Same taste. I'm keeping a list.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_lick_2",
      "text": "Lick count: forty rocks. The embers taste like burnt toast. ...Don't picture that.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:11"
      ]
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_lick_3",
      "text": "Lick count: two hundred. The Magma King's throne tastes like gravy. Please don't tell him I licked it.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:31"
      ]
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_gossip_1",
      "text": "The baker's daughter and the blacksmith. Still. Nobody's said anything. Everybody knows.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_gossip_2",
      "text": "Guess what. The baker's daughter wrote to the blacksmith. Down here. I read it. ...I held it. Not read.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:11"
      ]
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_gossip_3",
      "text": "They're engaged! I heard it from a damned soul. The soul's thrilled. The soul is dead. Lovely day.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:31"
      ]
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_pockets",
      "text": "I still haven't any pockets. Have you noticed? I keep checking.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "ShopIdle",
      "floor": 0,
      "sound": "vo_yooba_humming",
      "text": "Hm-hm-hm-hmmm... Sorry. Humming. It isn't a song. It's just what I do when nobody's talking.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": false,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "QuestOffer",
      "floor": 0,
      "sound": "vo_yooba_quest_offer",
      "text": "Psst. Three things fell out of the village when the portal took us. The baker's rolling pin, the blacksmith's mitt, the bell's clapper. Find them on the floors and I'll make it worth your while.",
      "clip": "talk",
      "reply": "vo_hero_yooba_quest_ask",
      "replyText": "They're in Hell. Of course they are.",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "level:3"
      ]
    },
    {
      "moment": "QuestRemind",
      "floor": 0,
      "sound": "vo_yooba_quest_remind1",
      "text": "Still some of my lost things out there! I can smell the baker's flour from here. It's very faint. It's very sad.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "QuestRemind",
      "floor": 0,
      "sound": "vo_yooba_quest_remind2",
      "text": "Not to nag. Just: bell, pin, mitt. Pin, mitt, bell. I'm saying it so I don't lose them too.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "QuestFound",
      "floor": 0,
      "sound": "vo_yooba_quest_pin",
      "text": "My baker's pin! He'll weep. Then shout. Both lovely.",
      "clip": "laugh",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "flag:lost.pin"
      ]
    },
    {
      "moment": "QuestFound",
      "floor": 0,
      "sound": "vo_yooba_quest_mitt",
      "text": "The blacksmith's mitt! Smells of coal and sweat and, ooh, a little bit of romance.",
      "clip": "cough",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "flag:lost.mitt"
      ]
    },
    {
      "moment": "QuestFound",
      "floor": 0,
      "sound": "vo_yooba_quest_bell",
      "text": "The bell's clapper! Dong. Dong. ...That wasn't me. That was my tummy.",
      "clip": "talk",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": [
        "flag:lost.bell"
      ]
    },
    {
      "moment": "QuestDone",
      "floor": 0,
      "sound": "vo_yooba_quest_done1",
      "text": "All three! You marvellous thing. Sixty diamonds and a jar for the shelf. I'd hug you but, you know. Slime.",
      "clip": "laugh",
      "reply": "vo_hero_yooba_quest_done",
      "replyText": "Please don't.",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": []
    },
    {
      "moment": "QuestDone",
      "floor": 0,
      "sound": "vo_yooba_quest_done2",
      "text": "That's the whole village's lost-and-found, found! I'm putting it on the shelf where I can see it.",
      "clip": "cough",
      "reply": "",
      "replyText": "",
      "once": true,
      "item": "",
      "minDeaths": 0,
      "requires": []
    }
