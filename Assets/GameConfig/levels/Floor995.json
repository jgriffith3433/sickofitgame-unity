    "rules": [
      {
        "name": "the second lap: the floor repeats",
        "when": {
          "type": "sectionReached",
          "section": "lap2"
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "cameraShake",
            "intensity": 0.05,
            "duration": 0.3
          },
          {
            "type": "emit",
            "signal": "loopRepeat"
          },
          {
            "type": "runSequence",
            "steps": [
              {
                "type": "wait",
                "seconds": 1.2
              },
              {
                "type": "showText",
                "text": "It's doing that on purpose.",
                "duration": 2.6,
                "style": "Subtitle",
                "sound": "vo_loop_purpose"
              },
              {
                "type": "wait",
                "seconds": 4.2
              },
              {
                "type": "showText",
                "text": "Hell runs on a loop. So I can drag it back.",
                "duration": 3.4,
                "style": "Subtitle",
                "sound": "vo_loop_grab"
              }
            ]
          }
        ]
      },
      {
