    "rules": [
      {
        "name": "the second lap: the floor repeats",
        "when": {
          "type": "sectionReached",
          "section": "lap2"
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "cameraShake",
            "intensity": 0.05,
            "duration": 0.3
          },
          {
            "type": "emit",
            "signal": "loopRepeat"
          },
          {
            "type": "runSequence",
            "steps": [
              {
                "type": "wait",
                "seconds": 1.2
              },
              {
                "type": "showText",
                "text": "It's doing that on purpose.",
                "duration": 2.6,
                "style": "Subtitle",
                "sound": "vo_loop_purpose"
              },
              {
                "type": "wait",
                "seconds": 4.2
              },
              {
                "type": "showText",
                "text": "Hell runs on a loop. So I can drag it back.",
                "duration": 3.4,
                "style": "Subtitle",
                "sound": "vo_loop_grab"
              }
            ]
          }
        ]
      },
      {
        "name": "the wall: the lava rises",
        "when": {
          "type": "sectionReached",
          "section": "wall"
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "setCounter",
            "name": "lavaMax",
            "value": 8.0
          },
          {
            "type": "setCounter",
            "name": "lavaSpeed",
            "value": 0.35
          }
        ]
      },
      {
        "name": "the landing",
        "when": {
          "type": "playerOn",
          "target": {
            "id": "landing"
          }
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "runSequence",
            "steps": [
              {
                "type": "setFloor",
                "floor": 994,
                "skipMilestones": true
              },
              {
                "type": "setCounter",
                "name": "lavaSpeed",
                "value": 0.0
              },
              {
                "type": "showText",
                "text": "THE LOOP: SURVIVED. AGAIN.",
                "duration": 2.4,
                "style": "Banner",
                "sound": "vo_loop_clear",
                "color": "#FFD27A"
              },
              {
                "type": "wait",
                "seconds": 2.6
              },
              {
                "type": "offerUpgrades",
                "title": "Pick a grudge"
              },
              {
                "type": "setCounter",
                "name": "cleared",
                "value": 1
              }
            ]
          }
        ]
      },
      {
        "name": "the second lap brings a second brute",
