                "anchor": "Camera",
                "at": [
                  5.0,
                  3.4
                ],
                "facePlayer": false
              },
              {
                "type": "cameraShake",
                "intensity": 0.1,
                "duration": 0.5
              },
              {
                "type": "showText",
                "text": "Hoooof. ... Fall, little sparks. Fall.",
                "duration": 3.0,
                "style": "Subtitle",
                "color": "#FF8C33"
              },
              {
                "type": "wait",
                "seconds": 3.4
              },
              {
                "type": "showText",
                "text": "Of course the sparks have a mother.",
                "duration": 2.8,
                "style": "Subtitle"
              }
            ]
          }
        ]
      },
