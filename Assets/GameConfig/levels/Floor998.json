                "duration": 0.4
              },
              {
                "type": "setCounter",
                "name": "lavaMax",
                "value": 7.0
              },
              {
                "type": "setCounter",
                "name": "lavaSpeed",
                "value": 0.4
              },
              {
                "type": "wait",
                "seconds": 2.6
              },
              {
                "type": "showText",
                "text": "A LADDER! HOW CONVENIENT! HOW SUSPICIOUS!",
                "duration": 2.8,
                "style": "Banner",
                "color": "#FFD27A"
              }
            ]
          }
        ]
      },
      {
        "name": "Mother Cinder looms over the rain",
        "when": {
          "type": "sectionReached",
          "section": "emberfall"
