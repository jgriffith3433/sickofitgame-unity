            "steps": [
              {
                "type": "setFloor",
                "floor": 951,
                "skipMilestones": true
              },
              {
                "type": "setCounter",
                "name": "lavaSpeed",
                "value": 0.0
              },
              {
                "type": "showText",
                "text": "THE SACK PILE: SPILLED",
                "duration": 2.4,
                "style": "Banner",
                "sound": "vo_f952_clear",
                "color": "#FFD27A"
              },
              {
                "type": "wait",
                "seconds": 2.6
              },
              {
                "type": "offerUpgrades",
                "title": "Pick a grudge"
              },
              {
                "type": "setCounter",
                "name": "cleared",
                "value": 1
              }
            ]
          }
        ]
      },
