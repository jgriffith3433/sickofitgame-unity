    "rules": [
      {
        "name": "the side of the pile: the lava rises",
        "when": {
          "type": "sectionReached",
          "section": "pileSide"
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "playMusic",
            "clip": "Audio/Music/wastes_push.ogg",
            "volume": 0.85
          },
          {
            "type": "setCounter",
            "name": "lavaMax",
