          ]
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "runSequence",
            "steps": [
              {
                "type": "wait",
                "seconds": 0.5
              },
              {
                "type": "cameraShake",
                "intensity": 0.25,
                "duration": 0.8
              },
              {
                "type": "playSound",
                "sound": "sack_spill"
              },
              {
                "type": "slowMotion",
                "scale": 0.35,
                "duration": 0.6
              },
              {
                "type": "spawn",
                "entity": "diamond",
                "anchor": "Camera",
                "at": [
                  -1.0,
                  1.2
                ],
                "count": 8,
                "spacing": [
                  0.4,
                  0.0
                ],
                "facePlayer": false
              },
              {
                "type": "showText",
                "text": "He keeps guards. So he's expecting someone.",
                "duration": 3.55,
                "style": "Subtitle",
                "sound": "vo_pile_expecting"
              },
              {
                "type": "wait",
                "seconds": 1.0
              },
              {
                "type": "nextSection"
              }
            ]
          }
        ]
      },
      {
        "name": "the landing",
        "when": {
          "type": "playerOn",
          "target": {
            "id": "landing"
          }
        },
        "maxTimes": 1,
        "do": [
          {
