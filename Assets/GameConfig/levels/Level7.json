    "world": {
      "camera": "Travel",
      "travelDirection": "Right",
      "travelLead": 1.5,
      "travelSpeed": 0.5,
      "travelLength": 74.0,
      "followSharpness": 4.0,
      "holdForPushes": true
    },
    "markers": [
      { "floor": 897, "label": "DEMON" },
      { "floor": 877, "label": "THE TOP" }
    ],
    "objective": {
      "complete": { "type": "counter", "name": "cleared", "atLeast": 1 },
      "text": "Climb"
    },
    "phases": [
      {
        "name": "road",
        "onEnter": [
          {
            "type": "showText",
            "text": "FLOORS 900-876: THE CRACKED ROAD",
            "duration": 2.5,
            "sound": "vo_road_title",
            "color": "#FFB46A"
          }
        ],
        "rules": [
          {
            "name": "the hero takes it in",
            "when": { "type": "after", "seconds": 2.8 },
            "do": [
              {
                "type": "showText",
                "text": "New Circle. Same heat.",
                "duration": 3.0,
                "sound": "vo_road_intro",
                "style": "Subtitle"
              }
            ]
          },
          {
            "when": { "type": "after", "seconds": 6.0 },
            "do": [ { "type": "goToPhase", "phase": "firstDemon" } ]
          }
        ]
      },
      {
        "name": "firstDemon",
        "onEnter": [
          { "type": "lockTravel" },
          { "type": "cameraShake", "intensity": 0.15, "duration": 1.2 },
          {
            "type": "showText",
            "text": "The road's splitting.",
            "duration": 2.0,
            "sound": "vo_road_crack",
            "style": "Subtitle"
          }
        ],
        "rules": [
          {
            "name": "a demon climbs out, alone",
            "when": { "type": "after", "seconds": 1.6 },
            "maxTimes": 1,
            "do": [
              {
                "type": "spawn",
                "entity": "brimstoneDemon",
                "anchor": "Camera",
                "at": [3.6, -1.95],
                "tags": ["beat"]
              }
            ]
          },
          {
            "name": "the hero reads it",
            "when": { "type": "after", "seconds": 3.0 },
            "maxTimes": 1,
            "do": [
              {
                "type": "showText",
                "text": "It came out of the road. To keep me off the road.",
                "duration": 3.0,
                "sound": "vo_road_demon",
                "style": "Subtitle"
              }
            ]
          },
          {
            "name": "demon down",
            "when": { "type": "allDead", "target": { "tag": "beat" } },
            "maxTimes": 1,
            "do": [
              { "type": "unlockTravel" },
              { "type": "goToPhase", "phase": "climbToTop" }
            ]
          }
        ]
      },
      {
        "name": "climbToTop",
        "onEnter": [
          { "type": "generateFloors", "untilFloor": 877, "firstBreather": 4.0 }
        ],
        "rules": [
          {
            "when": { "type": "signal", "name": "floorsDone" },
            "maxTimes": 1,
            "do": [ { "type": "goToPhase", "phase": "top" } ]
          }
        ]
      },
      {
        "name": "top",
        "onEnter": [
          {
            "type": "showText",
            "text": "Eight seventy-six. Still not one.",
            "duration": 3.0,
            "sound": "vo_road_top",
            "style": "Subtitle"
          }
        ],
        "rules": [
          {
            "name": "stage clear",
            "when": { "type": "floorReached", "floor": 876 },
            "maxTimes": 1,
            "do": [
              {
                "type": "runSequence",
                "steps": [
                  { "type": "lockTravel" },
                  {
                    "type": "showText",
                    "text": "THE CRACKED ROAD: CROSSED",
                    "duration": 2.0,
                    "sound": "vo_road_clear",
                    "color": "#FFB46A"
                  },
                  { "type": "wait", "seconds": 1.5 },
                  { "type": "offerUpgrades", "title": "Pick a grudge" },
                  { "type": "setCounter", "name": "cleared", "value": 1 }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
