        "rules": [
          {
            "when": { "type": "signal", "name": "floorsDone" },
            "maxTimes": 1,
            "do": [ { "type": "goToPhase", "phase": "top" } ]
          }
        ]
      },
      {
        "name": "top",
        "onEnter": [
          {
            "type": "showText",
            "text": "Twenty-four floors. Nine hundred seventy-five to go.",
            "duration": 3.5,
            "sound": "vo_landing_top",
            "style": "Subtitle"
          }
        ],
        "rules": [
          {
            "name": "stage clear",
            "when": { "type": "floorReached", "floor": 976 },
