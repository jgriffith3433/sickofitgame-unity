            "do": [
              {
                "type": "runSequence",
                "steps": [
                  { "type": "lockTravel" },
                  {
                    "type": "showText",
                    "text": "THE LANDING: SURVIVED",
                    "duration": 2.0,
                    "sound": "vo_landing_clear",
                    "color": "#FF9A5C"
