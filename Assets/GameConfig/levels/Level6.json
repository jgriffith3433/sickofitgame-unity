            "maxTimes": 1,
            "do": [
              { "type": "unlockTravel" },
              { "type": "goToPhase", "phase": "climbToTop" }
            ]
          }
        ]
      },
      {
        "name": "climbToTop",
        "onEnter": [
          { "type": "generateFloors", "untilFloor": 977, "firstBreather": 3.0, "seed": 1 }
