          }
        ]
      },
      {
        "name": "climbToCinders",
        "onEnter": [
          { "type": "generateFloors", "untilFloor": 990, "firstBreather": 3.0 }
        ],
        "rules": [
          {
            "when": { "type": "signal", "name": "floorsDone" },
            "maxTimes": 1,
            "do": [ { "type": "goToPhase", "phase": "cinders" } ]
          }
        ]
      },
      {
        "name": "cinders",
        "onEnter": [
          { "type": "lockTravel" },
          {
            "type": "showText",
            "text": "Sparks from the meadow. They followed me. Rude.",
            "duration": 3.0,
            "sound": "vo_landing_cinders",
            "style": "Subtitle"
          }
        ],
        "rules": [
          {
            "name": "first cinders, alone",
            "when": { "type": "after", "seconds": 1.5 },
            "do": [
              {
                "type": "spawnWave",
                "entity": "cinder",
                "count": 2,
                "interval": 0,
                "anchor": "Camera",
                "points": [[4.2, 0.8], [4.2, 1.4]],
                "tags": ["beat"]
              }
            ]
          },
          {
            "name": "cinders out",
