{
  "schemaVersion": 1,
  "levelName": "Level2",
  "displayName": "Floors 1000-991: The Landing",
  "levelNumber": 2,
  "thumbnail": "Videos/Video2_FirstFrame.png",
  "backgrounds": [],
  "backgroundLayers": [],
  "music": "Videos/Level3_Background1_Audio.mp3",
  "musicVolume": 1.0,
  "platforms": [],
  "placedSprites": [],
  "enemies": [],
  "playerSpawnPosition": [-4.0, 0.0],
  "deathConfigName": "Death1",
  "duration": 150.0,
  "completionDelay": 2.0,
  "nextVideoNumber": 3,
  "returnToMainMenuOnComplete": false,
  "script": {
    "length": 75,
    "floors": {
      "start": 1000,
      "end": 991,
      "unitsPerFloor": 3.0,
      "circle": "emberWastes",
      "signs": true
    },
    "world": {
      "camera": "Travel",
      "travelDirection": "Right",
      "travelLead": 1.5,
      "travelLength": 29.0,
      "followSharpness": 4.0,
      "holdForPushes": true
    },
    "markers": [
      { "floor": 999, "label": "999 TO GO" },
      { "floor": 992, "label": "THE TOP" }
    ],
    "objective": {
      "complete": { "type": "counter", "name": "cleared", "atLeast": 1 },
      "text": "Climb"
    },
    "rules": [
      {
        "name": "the hero answers the 999 milestone",
        "when": { "type": "floorReached", "floor": 999 },
        "maxTimes": 1,
        "do": [
          {
            "type": "runSequence",
            "steps": [
              { "type": "wait", "seconds": 2.8 },
              {
                "type": "showText",
                "text": "You said that already.",
                "duration": 2.5,
                "sound": "vo_landing_999",
                "style": "Subtitle"
              }
            ]
          }
        ]
      }
    ],
    "phases": [
      {
        "name": "landing",
        "onEnter": [
          { "type": "lockTravel" },
          {
            "type": "showText",
            "text": "FLOORS 1000-991: THE LANDING",
            "duration": 2.5,
            "sound": "vo_landing_title",
            "color": "#FFD27A"
          }
        ],
        "rules": [
          {
            "name": "the hero takes it in",
            "when": { "type": "after", "seconds": 2.8 },
            "do": [
              {
                "type": "showText",
                "text": "Floor one thousand. Of course it's a thousand.",
                "duration": 3.0,
                "sound": "vo_landing_intro",
                "style": "Subtitle"
              }
            ]
          },
          {
            "when": { "type": "after", "seconds": 6.0 },
            "do": [ { "type": "goToPhase", "phase": "firstImp" } ]
          }
        ]
      },
      {
        "name": "firstImp",
        "onEnter": [
          {
            "type": "spawn",
            "entity": "imp",
            "anchor": "Camera",
            "at": [3.6, -1.4],
            "tags": ["beat"]
          },
          {
            "type": "showText",
            "text": "An imp. Holding our diamond. Hi.",
            "duration": 3.0,
            "sound": "vo_landing_imp",
            "style": "Subtitle"
          }
        ],
        "rules": [
          {
            "name": "imp down",
            "when": { "type": "allDead", "target": { "tag": "beat" } },
            "maxTimes": 1,
            "do": [
              { "type": "unlockTravel" },
              { "type": "goToPhase", "phase": "climb" }
            ]
          }
        ]
      },
      {
        "name": "climb",
        "onEnter": [
          { "type": "generateFloors", "untilFloor": 992, "firstBreather": 3.0 }
        ],
        "rules": [
          {
            "when": { "type": "signal", "name": "floorsDone" },
            "maxTimes": 1,
            "do": [ { "type": "goToPhase", "phase": "top" } ]
          }
        ]
      },
      {
        "name": "top",
        "onEnter": [
          {
            "type": "showText",
            "text": "Ten floors. Nine hundred ninety to go.",
            "duration": 3.5,
            "sound": "vo_landing_top",
            "style": "Subtitle"
          }
        ],
        "rules": [
          {
            "name": "stage clear",
            "when": { "type": "floorReached", "floor": 991 },
            "maxTimes": 1,
            "do": [
              {
                "type": "runSequence",
                "steps": [
                  { "type": "lockTravel" },
                  {
                    "type": "showText",
                    "text": "THE LANDING: SURVIVED",
                    "duration": 2.0,
                    "sound": "vo_landing_clear",
                    "color": "#FF9A5C"
                  },
                  { "type": "wait", "seconds": 1.5 },
                  { "type": "offerUpgrades", "title": "Pick a grudge" },
                  { "type": "setCounter", "name": "cleared", "value": 1 }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
