              {
                "type": "wait",
                "seconds": 3.0
              },
              {
                "type": "showText",
                "text": "A ladder. Hell finally built something that goes up on purpose.",
                "duration": 3.0,
                "style": "Subtitle",
                "color": "#D2DAE4"
