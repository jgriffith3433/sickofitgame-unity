                        "at": [
                          0.0,
                          1.2
                        ],
                        "anchor": "Player"
                      },
                      {
                        "type": "emit",
                        "signal": "cmp:wick:999:reward:heart"
                      },
                      {
                        "type": "setFlag",
                        "flag": "wick.met"
                      },
                      {
                        "type": "emit",
                        "signal": "cmp:wick:999:done"
                      },
                      {
                        "type": "walkEntityTo",
                        "target": "cmp",
                        "x": 14.0,
                        "relativeTo": "player",
                        "speed": 3.0
                      },
                      {
                        "type": "wait",
                        "seconds": 3.0
                      },
                      {
                        "type": "despawn",
                        "target": {
                          "id": "cmp"
                        }
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "type": "runSequence",
                    "steps": [
                      {
                        "type": "emit",
                        "signal": "cmp:wick:999:branch:plain"
                      },
                      {
                        "type": "showText",
                        "text": "Wick: The lava rises here. Don't stand still.",
                        "duration": 3.9,
                        "style": "Subtitle",
                        "color": "#BFE6C8",
                        "sound": "vo_wick999_plain0"
                      },
                      {
                        "type": "wait",
                        "seconds": 4.2
                      },
                      {
                        "type": "showText",
                        "text": "I wasn't going to.",
                        "duration": 2.2,
                        "style": "Subtitle",
                        "sound": "vo_hero_cmp_i_wasn_t_going_to"
