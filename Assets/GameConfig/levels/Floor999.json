                      {
                        "type": "wait",
                        "seconds": 4.9
                      },
                      {
                        "type": "showText",
                        "text": "Thanks.",
                        "duration": 1.8,
                        "style": "Subtitle",
                        "sound": "vo_hero_cmp_thanks"
                      },
                      {
                        "type": "wait",
                        "seconds": 2.1
                      },
                      {
                        "type": "heal",
                        "target": {
                          "player": true
                        },
                        "amount": 1
                      },
                      {
                        "type": "popText",
                        "text": "+1 heart",
                        "color": [
                          1.0,
                          0.45,
                          0.5,
                          1.0
