                      {
                        "type": "setFlag",
                        "flag": "wick.met"
                      },
                      {
                        "type": "emit",
                        "signal": "cmp:wick:999:done"
                      },
                      {
                        "type": "walkEntityTo",
                        "target": "cmp",
                        "x": 14.0,
                        "relativeTo": "player",
                        "speed": 3.0
