    "rules": [
      {
        "name": "the first stone sinks under him",
        "when": {
          "type": "playerOn",
          "target": {
            "id": "stone1"
          }
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "cameraShake",
            "intensity": 0.05,
            "duration": 0.2
          },
          {
            "type": "showText",
            "text": "Even the floor wants me gone.",
            "duration": 2.6,
            "style": "Subtitle",
            "sound": "vo_f1000_floor"
          }
        ]
      },
      {
        "name": "the imp on the landing",
        "when": {
          "type": "sectionReached",
          "section": "top"
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "runSequence",
            "steps": [
              {
                "type": "playSound",
                "sound": "lava_bubble"
              },
              {
                "type": "wait",
                "seconds": 0.8
              },
              {
                "type": "showText",
                "text": "Hey. That's ours.",
                "duration": 2.6,
                "style": "Subtitle",
                "sound": "vo_f1000_ours"
              }
            ]
          }
        ]
      },
      {
        "name": "the landing",
        "when": {
          "type": "playerOn",
          "target": {
            "id": "landing"
          }
        },
        "maxTimes": 1,
        "do": [
          {
            "type": "runSequence",
            "steps": [
              {
                "type": "setFloor",
                "floor": 999,
                "skipMilestones": true
              },
              {
                "type": "setCounter",
                "name": "lavaSpeed",
                "value": 0.0
              },
              {
                "type": "showText",
                "text": "THE LANDING: SURVIVED",
                "duration": 2.4,
                "style": "Banner",
                "sound": "vo_landing_clear",
                "color": "#FFD27A"
              },
              {
                "type": "playSound",
                "sound": "sting_rank_b",
                "volume": 1.0
              },
              {
                "type": "emit",
                "signal": "floors:1000:payoff"
              },
              {
                "type": "wait",
                "seconds": 2.6
              },
              {
                "type": "offerUpgrades",
                "title": "Pick a grudge"
              },
              {
                "type": "setCounter",
                "name": "cleared",
                "value": 1
              }
            ]
